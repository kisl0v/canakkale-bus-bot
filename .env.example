# Bu dosyayı ".env" adıyla kopyala ve doldur. .env'i kimseyle paylaşma.

# @BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=

# Bildirimlerin gideceği sohbet ID'si (botu başlatıp /start yazınca öğrenirsin)
# Birden fazlası için virgülle ayır: 123456789,-1001234567890
TELEGRAM_CHAT_ID=

# Kaç dakikada bir kontrol edilsin (varsayılan 30)
CHECK_INTERVAL_MINUTES=30

# Arkadaşların /abone ile abone olabilsin diye davet kodu (boş bırakırsan herkes abone olabilir)
SUBSCRIBE_CODE=
